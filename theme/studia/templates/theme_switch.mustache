{{!
    @template theme_studia/theme_switch

    Light/dark mode switch. It is a normal POST form protected by the Moodle
    sesskey; the preference is stored on the server.

    Context variables required for this template:
    * isdark - Whether the dark mode is active.
    * nextmode - Mode to switch to.
    * title - Accessible label.
    * action - Toggle URL.

    Example context (json):
    {
        "isdark": false,
        "nextmode": "dark",
        "title": "Prebaci na tamni način",
        "action": "https://moodle.example/theme/studia/toggle.php"
    }
}}
<form class="studia-theme-switch" method="post" action="{{{action}}}">
    <input type="hidden" name="sesskey" value="{{config.sesskey}}">
    <input type="hidden" name="mode" value="{{nextmode}}">
    <button type="submit" class="studia-icon-btn" title="{{title}}" aria-label="{{title}}">
        {{#isdark}}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="M4.93 4.93l1.41 1.41"></path>
                <path d="M17.66 17.66l1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="M4.93 19.07l1.41-1.41"></path>
                <path d="M17.66 6.34l1.41-1.41"></path>
            </svg>
        {{/isdark}}
        {{^isdark}}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
        {{/isdark}}
    </button>
</form>
