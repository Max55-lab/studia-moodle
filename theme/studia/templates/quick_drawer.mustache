{{!
    @template theme_studia/quick_drawer

    Compact Studia navigation drawer.

    Context variables required for this template:
    * user - Array with name, email, profileurl and picture.
    * courses - Array of courses with name and url.
    * coursesurl - URL of the course list.
    * gradesurl - URL of the grade report.
    * calendarurl - URL of the calendar.

    Example context (json):
    {
        "user": {
            "name": "Ana Anić",
            "email": "ana@example.com",
            "profileurl": "https://moodle.example/user/profile.php?id=2",
            "picture": "https://moodle.example/pluginfile.php/2/user/icon/..."
        },
        "courses": [
            {
                "name": "Programiranje",
                "url": "https://moodle.example/course/view.php?id=3"
            }
        ],
        "coursesurl": "https://moodle.example/my/courses.php",
        "gradesurl": "https://moodle.example/grade/report/user/index.php?id=2",
        "calendarurl": "https://moodle.example/calendar/view.php"
    }
}}
<div class="studia-quick-backdrop" data-action="studia-close-quick-drawer"></div>
<aside class="studia-quick-drawer" data-region="studia-quick-drawer" aria-label="{{#str}}quickmenu, theme_studia{{/str}}" aria-hidden="true">
    <div class="studia-quick__head">
        <h2 class="studia-quick__title">{{#str}}quickmenu, theme_studia{{/str}}</h2>
        <button type="button" class="studia-icon-btn studia-quick__close" data-action="studia-close-quick-drawer" title="{{#str}}closemenu, theme_studia{{/str}}" aria-label="{{#str}}closemenu, theme_studia{{/str}}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6L6 18"></path>
                <path d="M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <a class="studia-quick__profile" href="{{{user.profileurl}}}">
        <span class="studia-quick__avatar">
            <img src="{{user.picture}}" alt="">
        </span>
        <span class="studia-quick__profile-text">
            <span class="studia-quick__name">{{user.name}}</span>
            <span class="studia-quick__email">{{user.email}}</span>
        </span>
    </a>

    <h3 class="studia-quick__label">{{#str}}mycourses, theme_studia{{/str}}</h3>
    <nav class="studia-quick__nav" aria-label="{{#str}}mycourses, theme_studia{{/str}}">
        {{#courses}}
            <a class="studia-quick__link" href="{{{url}}}">
                <span class="studia-quick__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                </span>
                <span class="studia-quick__link-text">{{name}}</span>
                <svg class="studia-quick__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 18l6-6-6-6"></path>
                </svg>
            </a>
        {{/courses}}
        {{^courses}}
            <p class="studia-quick__empty">{{#str}}nocourses, theme_studia{{/str}}</p>
        {{/courses}}
    </nav>

    <h3 class="studia-quick__label">{{#str}}grades, theme_studia{{/str}} &amp; {{#str}}calendar, theme_studia{{/str}}</h3>
    <nav class="studia-quick__nav" aria-label="{{#str}}grades, theme_studia{{/str}}">
        <a class="studia-quick__link" href="{{{gradesurl}}}">
            <span class="studia-quick__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path>
                </svg>
            </span>
            <span class="studia-quick__link-text">{{#str}}grades, theme_studia{{/str}}</span>
            <svg class="studia-quick__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18l6-6-6-6"></path>
            </svg>
        </a>
        <a class="studia-quick__link" href="{{{calendarurl}}}">
            <span class="studia-quick__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <path d="M16 2v4"></path>
                    <path d="M8 2v4"></path>
                    <path d="M3 10h18"></path>
                </svg>
            </span>
            <span class="studia-quick__link-text">{{#str}}calendar, theme_studia{{/str}}</span>
            <svg class="studia-quick__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18l6-6-6-6"></path>
            </svg>
        </a>
    </nav>

    <div class="studia-quick__footer">
        <span class="studia-quick__footer-label">{{#str}}myprofile, theme_studia{{/str}}</span>
        <a class="studia-section-link" href="{{{user.profileurl}}}">{{#str}}viewprofile, theme_studia{{/str}}</a>
    </div>
</aside>
